{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The browser application: kernel, domain, platform adapters, feature modules and UI.",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "lit": "3.3.3",
    "valibot": "1.5.0",
    "vite": "8.3.5"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --config electron-builder.config.mjs --publish never",
    "package:dir": "electron-vite build && electron-builder --config electron-builder.config.mjs --publish never --dir",
    "test:e2e": "playwright test"
  }
}
