{
  "name": "lampo-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "verify": "node tools/verify.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "check:commits": "node tools/ci/check-commits.ts",
    "typecheck": "tsc --build app",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "pnpm --dir app exec vitest run",
    "test:coverage": "pnpm --dir app exec vitest run --coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@vitest/coverage-v8": "5.0.5",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
