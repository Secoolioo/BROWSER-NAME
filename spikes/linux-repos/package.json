{
  "name": "repo-spike",
  "productName": "RepoSpike",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "description": "Repository spike",
  "author": "Lampo maintainers",
  "homepage": "https://secoolioo.github.io/lampo/",
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.secoolioo.repospike",
    "productName": "RepoSpike",
    "executableName": "repo-spike",
    "files": [
      "main.mjs",
      "package.json"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "artifactName": "repo-spike-linux-${arch}.${ext}",
      "category": "Network",
      "maintainer": "Lampo maintainers"
    }
  }
}
