{
  "name": "website",
  "private": true,
  "type": "module",
  "description": "The public website: landing page, documentation, API reference and changelog.",
  "scripts": {
    "sync": "node scripts/sync-docs.ts",
    "build": "node scripts/sync-docs.ts && astro build",
    "dev": "node scripts/sync-docs.ts && astro dev",
    "check": "node scripts/sync-docs.ts && astro check",
    "check:api": "typedoc --options typedoc.json --emit none"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.2",
    "mermaid": "12.2.0",
    "starlight-typedoc": "0.23.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "6.0.3"
  }
}
